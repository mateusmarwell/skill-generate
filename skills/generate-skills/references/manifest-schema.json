{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Spec Skill Manifest",
  "type": "object",
  "properties": {
    "project": {
      "type": "object",
      "properties": {
        "name": { "type": ["string", "null"] },
        "languages": { "type": "array", "items": { "type": "string" } },
        "architecture": { "type": ["string", "null"] }
      },
      "required": ["name", "languages", "architecture"]
    },
    "detected_stack": {
      "type": "object",
      "properties": {
        "backend": { "type": "array", "items": { "type": "string" } },
        "frontend": { "type": "array", "items": { "type": "string" } },
        "database": { "type": "array", "items": { "type": "string" } },
        "persistence": { "type": "array", "items": { "type": "string" } },
        "testing": { "type": "array", "items": { "type": "string" } },
        "build": { "type": "array", "items": { "type": "string" } },
        "infrastructure": { "type": "array", "items": { "type": "string" } },
        "integrations": { "type": "array", "items": { "type": "string" } },
        "ci_cd": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "object",
      "properties": {
        "required": { "type": "array", "items": { "type": "string" } },
        "discovered": { "type": "array", "items": { "type": "string" } },
        "used": { "type": "array", "items": { "type": "string" } },
        "ignored": { "type": "array", "items": { "type": "string" } },
        "missing": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "generated_skills": {
      "type": "array",
      "items": { "type": "string" }
    },
    "suggested_skills": {
      "type": "array",
      "items": { "type": "string" }
    },
    "changes": {
      "type": "object",
      "properties": {
        "added": { "type": "array", "items": { "type": "string" } },
        "removed": { "type": "array", "items": { "type": "string" } },
        "replaced": { "type": "array", "items": { "type": "string" } },
        "deprecated": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "conflicts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "custom_blocks_preserved": {
      "type": "array",
      "items": { "type": "string" }
    },
    "last_generation": { "type": ["string", "null"] },
    "generation_mode": { "type": ["string", "null"] },
    "generation_status": { "type": "string" }
  },
  "required": [
    "project",
    "detected_stack",
    "sources",
    "generated_skills",
    "suggested_skills",
    "changes",
    "conflicts",
    "custom_blocks_preserved",
    "last_generation",
    "generation_mode",
    "generation_status"
  ]
}
